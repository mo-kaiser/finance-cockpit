# Supabase-URL und Publishable Key stehen in src/lib/supabase-config.ts (öffentlich).

# Geheim – nur als Vercel-Umgebungsvariablen, nie committen (werden für Cron & Bitget gebraucht)
# SUPABASE_SECRET_KEY=
# BITGET_API_KEY=
# BITGET_API_SECRET=
# BITGET_API_PASSPHRASE=
# CRON_SECRET=
# RESEND_API_KEY=        # E-Mail-Warnungen (resend.com)
# ALERT_EMAIL_TO=        # Empfänger (ohne eigene Domain: Adresse des Resend-Kontos)
# ALERT_EMAIL_FROM=      # optional, Standard: Cockpit <onboarding@resend.dev>
# BACKUP_SECRET=         # für die GitHub-Action der Datensicherung (gleicher Wert als Repo-Secret)
